# experiments/.env — copy to experiments/.env and fill in values
# Used by eval_output_quality.py for LLM-as-judge rubric scoring.
# This file must NOT be committed — add experiments/.env to .gitignore.

# Groq API key — required for LLM-as-judge scoring of persona_synthesizer
# and snippet_summarizer chains. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq judge model — defaults to openai/gpt-oss-120b if not set.
# Supported reasoning models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3-32b
GROQ_MODEL=openai/gpt-oss-120b
