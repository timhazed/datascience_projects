# Developer Memory — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Git / GitHub ─────────────────────────────────────────────────────────────
# Personal access token for PyGithub private repo access
GITHUB_TOKEN=ghp_REPLACE_ME

# ── Ollama ────────────────────────────────────────────────────────────────────
# Mode A (recommended): Ollama runs natively on macOS for full Metal GPU acceleration.
# Start it with: ollama serve
#
# Default for macOS host (experiments, CLI tools):
OLLAMA_HOST=http://localhost:11434
#
# If running via Docker (make up), docker-compose.yml overrides this to:
#   OLLAMA_HOST=http://host.docker.internal:11434
# so containers reach the native Ollama process through Docker's host gateway.

# MoE variant (gemma4:26b): 4B active params/token — recommended for inference speed.
# Dense alternative: gemma4:27b-it (higher quality, more RAM). TBD-01 resolved.
OLLAMA_MODEL=gemma4:26b

# Skills synthesis model — override to use a higher-quality model for PROJECT_SKILLS.md
# generation independently of the main inference model. Defaults to OLLAMA_MODEL if unset.
# Recommendation: gpt-oss:20b produces materially better grounded output for export jobs
# (see docs/model_evaluation_report.md). phi4-mini is acceptable for fast iteration.
OLLAMA_SKILLS_MODEL=gpt-oss:20b

# Embedding model — must be a dedicated embedding model (not a generative model).
# nomic-embed-text is pulled by default and used across all experiments.
# Alternative: mxbai-embed-large (1024 dims, 512-token window) — pull separately.
OLLAMA_EMBED_MODEL=nomic-embed-text

# REQUIRED: allows containerized MCP server to call native Ollama (bypasses CORS).
# One-time setup on macOS host: launchctl setenv OLLAMA_ORIGINS "*"
# This env var is read by the native Ollama process — not by Docker.
OLLAMA_ORIGINS=*

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Internal Docker network address (used by mcp-server and streamlit containers)
CHROMA_HOST=http://chromadb:8000

# ChromaDB collection name
CHROMA_COLLECTION=developer_memory_v1

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_PORT=9000
MCP_TRANSPORT=http

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── PII Sanitizer (Presidio) ─────────────────────────────────────────────────
# en_core_web_lg: ~560 MB, better Organization/Location accuracy on M4 Max. TBD-02 resolved.
PRESIDIO_SPACY_MODEL=en_core_web_lg

# ── Performance ───────────────────────────────────────────────────────────────
# Ollama context window — must fit largest file chunk + system prompt
OLLAMA_NUM_CTX=8192

# Number of parallel LLM requests Ollama will serve simultaneously.
# Must match OLLAMA_NUM_PARALLEL set on the Ollama server process itself.
# M4 Max 128GB: use 2 (two KV caches fit; bandwidth-bound beyond that).
# All other configs: use 1 (serial) unless you have measured headroom.
# Setting this higher than Ollama's actual OLLAMA_NUM_PARALLEL causes queueing on the
# Ollama side with no throughput benefit — each extra goroutine just waits.
OLLAMA_NUM_PARALLEL=2

# Number of parallel file parsing workers (set to number of P-cores on M4 Max)
PARSER_WORKERS=6    # Cap at 6 (min 4) — P-cores shared with Gemma 4 summarization. TBD-07 resolved.
