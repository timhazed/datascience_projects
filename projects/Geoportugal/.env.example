# GeoPortugal Environment Configuration
# Copy this file to ~/src/python/geoportugal/.env and customize the values
# CRITICAL: Change all default passwords and secrets before deployment!

# =============================================================================
# ENVIRONMENT DETECTION
# =============================================================================
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# =============================================================================
# DATABASE CREDENTIALS (PostgreSQL)
# =============================================================================
POSTGRES_DB=geoportugal
POSTGRES_USER=geoportugal_user
POSTGRES_PASSWORD=CHANGE-THIS-SECURE-PASSWORD

# PostgreSQL Database URL for FastAPI
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DATABASE_ECHO=false

# Connection Pool Settings
MAX_CONNECTIONS=20
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# Test Database (for running tests)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geoportugal_test

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# Cache TTL Settings (in seconds)
CACHE_TTL=300
CACHE_TTL_DISTRICTS=3600
CACHE_TTL_MUNICIPALITIES=3600
CACHE_TTL_LOCALITIES=1800
CACHE_TTL_SEARCH=900

# =============================================================================
# SECURITY CONFIGURATION (CRITICAL)
# =============================================================================
# Secret key for JWT and security - MUST be changed in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production-use-at-least-32-characters

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API Metadata
API_TITLE=GeoPortugal API
API_DESCRIPTION=Production-ready geospatial API serving hierarchical Portugal location data
API_VERSION=1.0.0
API_PORT=8000

# CORS Settings - MUST be configured for production
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Enable/disable features
ENABLE_METRICS=true

# Metrics endpoint authentication (for /metrics endpoint)
# CHANGE THESE PASSWORDS IN PRODUCTION!
METRICS_USERNAME=admin
METRICS_PASSWORD=CHANGE-THIS-METRICS-PASSWORD

# =============================================================================
# DEVELOPMENT TOOLS (Optional)
# =============================================================================
# PGAdmin credentials
PGADMIN_DEFAULT_EMAIL=admin@geoportugal.com
PGADMIN_DEFAULT_PASSWORD=CHANGE-THIS-PGADMIN-PASSWORD

# Enable development features
RELOAD_ON_CHANGE=true
ENABLE_API_DOCS=true
ENABLE_GRAPHQL_PLAYGROUND=true

# =============================================================================
# PRODUCTION DEPLOYMENT (docker-compose.prod.yml)
# =============================================================================
# Docker Registry for production deployment
DOCKER_REGISTRY=your-registry.com
DOCKER_USERNAME=your-username  
DOCKER_PASSWORD=your-password

# Production monitoring
GRAFANA_PASSWORD=CHANGE-THIS-GRAFANA-PASSWORD

# Backup configuration
BACKUP_SCHEDULE=0 2 * * *
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
BACKUP_S3_BUCKET=geoportugal-backups

# SSL Certificate paths
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# Production workers
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
MAX_WORKER_CONNECTIONS=1000

# =============================================================================
# PRODUCTION OVERRIDES (uncomment and modify for production)
# =============================================================================
# DEBUG=false
# ENVIRONMENT=production  
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# POSTGRES_USER=prod_user
# POSTGRES_PASSWORD=super-secure-production-password
# DATABASE_URL=postgresql+asyncpg://prod_user:secure_password@db_host:5432/geoportugal_prod
# REDIS_URL=redis://redis_host:6379/0
# SECRET_KEY=your-super-secure-secret-key-at-least-32-characters-long
# CORS_ORIGINS=["https://yourdomain.com", "https://api.yourdomain.com"]
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# METRICS_PASSWORD=super-secure-metrics-password

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Copy this file to ~/python/geoportugal/.env (EXTERNAL to project)
# 2. Generate strong SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Change ALL passwords marked with "CHANGE-THIS"
# 4. Set DEBUG=false in production
# 5. Configure proper CORS origins for production
# 6. Use secure database credentials
# 7. Never commit the actual .env file to version control
