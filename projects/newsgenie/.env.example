# LLM Provider — "openai" or "groq" (both supported in v1.0)
LLM_PROVIDER=openai

# Model for supervisor_node (the only LLM call in the system)
SUPERVISOR_MODEL=gpt-4o-mini
# SUPERVISOR_MODEL=llama-3.1-70b-versatile  # for Groq

# LLM API keys — provide the key for whichever provider is selected above
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# News API Keys — missing key disables that agent gracefully
# Business News & General News → NewsAPI /v2/everything | Sports News → Guardian search
GUARDIAN_API_KEY=...
NEWSAPI_API_KEY=...

# Web search — pick one provider (like LLM_PROVIDER). Only the key for the selected provider is required.
WEB_SEARCH_PROVIDER=serpapi
# WEB_SEARCH_PROVIDER=serper

SERPAPI_API_KEY=...
SERPERDEV_API_KEY=...

# Tuning
MAX_ARTICLES_PER_AGENT=5
MAX_HISTORY_TURNS=10
LOG_LEVEL=INFO
